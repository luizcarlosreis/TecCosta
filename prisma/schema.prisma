// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CONDOMINIO_EMPRESA
  TECNICO
  TECCOSTA_GESTAO
  ADMINISTRADOR
  ADMINISTRADORA_CONDOMINIO
  CLIENTE
  GESTOR
}

enum RequestStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model User {
  id        String   @id @default(cuid())
  cpfCnpj   String   @unique
  name      String
  password  String
  role      Role     @default(CONDOMINIO_EMPRESA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  birthDate String?
  phone     String?
  subRole   String?

  // Relations
  managedClients Client[] @relation("ClientManager")
  technicalTasks MaintenanceRequest[] @relation("TechnicianAssigned")
}

model Client {
  id         String   @id @default(cuid())
  clientCode Int      @unique @default(autoincrement())
  name       String
  cnpj       String   @unique
  phone      String?
  cep        String?
  rua        String?
  numero     String?
  bairro     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  managers   User[]   @relation("ClientManager")
  contacts   Contact[]
  requests   MaintenanceRequest[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  role      String   // e.g., "Síndico", "Zelador"
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceRequest {
  id                Int           @id @default(autoincrement())
  description       String        // Descritivo da solicitação
  tipoChamado       String        // Operacionais | Emergenciais
  categoria         String        // Categoria (ex: Elétrica, Câmeras)
  subItem           String?       // Sub item opcional
  observacao        String?       // Observação livre
  openedBy          String?       // Nome de quem abriu o chamado
  createdById       String?       // ID de quem abriu o chamado
  // Campos de classificação
  nivelCriticidade  String?       // "1", "2", "3" ou "4"
  classifiedBy      String?       // Nome de quem classificou
  classifiedById    String?       // ID de quem classificou
  classifiedAt      DateTime?     // Data/hora da classificação
  dataAtendimento   DateTime?     // Data prevista de atendimento
  finishedAt        DateTime?     // Data/hora do atendimento real (finalização)
  finishedBy        String?       // Quem finalizou o chamado
  finalObservacao   String?       // Observações de encerramento
  status            RequestStatus @default(PENDENTE)
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  technicianId      String?
  technician        User?         @relation("TechnicianAssigned", fields: [technicianId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}
